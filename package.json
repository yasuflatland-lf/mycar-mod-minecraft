{
  "name": "yasuflatland-addon-minecraft",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:lang": "node scripts/check-language.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage '--coverage.include=src/**' --coverage.reporter=text --coverage.reporter=lcov",
    "model": "python3 -I tools/gen_model.py packs/yasuflatland_rp && biome format --write packs/yasuflatland_rp/models/entity/yasuflatland/suv.geo.json && python3 -I tools/render_preview.py packs/yasuflatland_rp docs/images",
    "sounds": "python3 -I tools/gen_sounds.py packs/yasuflatland_rp",
    "model:check": "python3 -I tools/render_preview.py packs/yasuflatland_rp docs/images --check",
    "server:up": "node scripts/server-up.mjs",
    "server:down": "docker compose -f server/compose.yaml down",
    "test:game": "node scripts/game-test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@minecraft/server": "2.10.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
