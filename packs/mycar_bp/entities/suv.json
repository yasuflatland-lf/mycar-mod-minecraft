{
  "format_version": "1.21.80",
  "minecraft:entity": {
    "description": {
      "identifier": "mycar:suv",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "mycar:flight": {
          "type": "enum",
          "values": ["ground", "takeoff", "flying", "landing"],
          "default": "ground",
          "client_sync": true
        },
        "mycar:bank": {
          "type": "float",
          "range": [-30.0, 30.0],
          "default": 0.0,
          "client_sync": true
        },
        "mycar:headlights": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "mycar:paint_khaki": { "minecraft:variant": { "value": 0 } },
      "mycar:paint_green": { "minecraft:variant": { "value": 1 } },
      "mycar:paint_red": { "minecraft:variant": { "value": 2 } },
      "mycar:hovering": { "minecraft:physics": { "has_gravity": false } },
      "mycar:grounded": { "minecraft:physics": {} }
    },
    "events": {
      "mycar:paint_khaki": {
        "add": { "component_groups": ["mycar:paint_khaki"] },
        "remove": {
          "component_groups": ["mycar:paint_green", "mycar:paint_red"]
        }
      },
      "mycar:paint_green": {
        "add": { "component_groups": ["mycar:paint_green"] },
        "remove": {
          "component_groups": ["mycar:paint_khaki", "mycar:paint_red"]
        }
      },
      "mycar:paint_red": {
        "add": { "component_groups": ["mycar:paint_red"] },
        "remove": {
          "component_groups": ["mycar:paint_khaki", "mycar:paint_green"]
        }
      },
      "mycar:hover": {
        "add": { "component_groups": ["mycar:hovering"] },
        "remove": { "component_groups": ["mycar:grounded"] }
      },
      "mycar:land": {
        "add": { "component_groups": ["mycar:grounded"] },
        "remove": { "component_groups": ["mycar:hovering"] }
      }
    },
    "components": {
      "minecraft:variant": { "value": 0 },
      "minecraft:type_family": { "family": ["mycar_vehicle", "inanimate"] },
      "minecraft:collision_box": { "width": 1.8, "height": 1.6 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:input_ground_controlled": {},
      "minecraft:can_power_jump": {},
      "minecraft:horse.jump_strength": { "value": 0 },
      "minecraft:movement": { "value": 0.0 },
      "minecraft:variable_max_auto_step": {
        "base_value": 1.0625,
        "jump_prevented_value": 1.0625
      },
      "minecraft:damage_sensor": {
        "triggers": { "cause": "all", "deals_damage": "no" }
      },
      "minecraft:rideable": {
        "seat_count": 4,
        "controlling_seat": 0,
        "crouching_skip_interact": true,
        "family_types": ["player"],
        "interact_text": "action.interact.ride.horse",
        "seats": [
          { "position": [-0.38, 0.4, 0.35], "lock_rider_rotation": 90 },
          { "position": [0.38, 0.4, 0.35] },
          { "position": [-0.38, 0.4, -0.8] },
          { "position": [0.38, 0.4, -0.8] }
        ]
      }
    }
  }
}
