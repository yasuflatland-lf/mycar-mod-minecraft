{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mycar.suv.flight": {
      "initial_state": "ground",
      "states": {
        "ground": {
          "animations": ["wheels"],
          "transitions": [
            { "deploy": "query.property('mycar:flight') != 'ground'" }
          ]
        },
        "deploy": {
          "animations": ["wheels_deploy"],
          "transitions": [{ "hover": "query.all_animations_finished" }]
        },
        "hover": {
          "animations": [
            "wheels_folded",
            "hover_glow",
            { "hover_sound_0": "query.ground_speed < 2" },
            {
              "hover_sound_1": "query.ground_speed >= 2 && query.ground_speed < 6"
            },
            {
              "hover_sound_2": "query.ground_speed >= 6 && query.ground_speed < 10"
            },
            {
              "hover_sound_3": "query.ground_speed >= 10 && query.ground_speed < 14"
            },
            { "hover_sound_4": "query.ground_speed >= 14" }
          ],
          "transitions": [
            { "retract": "query.property('mycar:flight') == 'ground'" }
          ]
        },
        "retract": {
          "animations": ["wheels_retract"],
          "transitions": [{ "ground": "query.all_animations_finished" }]
        }
      }
    }
  }
}
