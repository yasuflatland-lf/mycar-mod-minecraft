{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "mycar:suv",
      "materials": {
        "default": "entity_emissive_alpha",
        "lamp": "entity",
        "lamp_lit": "entity_emissive"
      },
      "textures": {
        "default": "textures/entity/suv",
        "green": "textures/entity/suv_green",
        "red": "textures/entity/suv_red"
      },
      "geometry": { "default": "geometry.mycar.suv" },
      "animations": {
        "wheels": "animation.mycar.suv.wheels",
        "wheels_deploy": "animation.mycar.suv.wheels_deploy",
        "wheels_folded": "animation.mycar.suv.wheels_folded",
        "wheels_retract": "animation.mycar.suv.wheels_retract",
        "hover_glow": "animation.mycar.suv.hover_glow",
        "exhaust": "animation.mycar.suv.exhaust",
        "flight": "controller.animation.mycar.suv.flight"
      },
      "particle_effects": {
        "exhaust": "minecraft:basic_smoke_particle",
        "hover_glow": "mycar:hover_glow"
      },
      "scripts": { "animate": ["flight", { "exhaust": "query.has_rider" }] },
      "render_controllers": ["controller.render.mycar.suv"]
    }
  }
}
