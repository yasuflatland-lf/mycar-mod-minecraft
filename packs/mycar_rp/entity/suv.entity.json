{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "mycar:suv",
      "materials": {
        "default": "entity_emissive_alpha",
        "lamp": "entity",
        "lamp_lit": "entity_emissive"
      },
      "textures": {
        "default": "textures/entity/suv",
        "green": "textures/entity/suv_green",
        "red": "textures/entity/suv_red",
        "white": "textures/entity/suv_white",
        "light_gray": "textures/entity/suv_light_gray",
        "gray": "textures/entity/suv_gray",
        "black": "textures/entity/suv_black",
        "orange": "textures/entity/suv_orange",
        "yellow": "textures/entity/suv_yellow",
        "lime": "textures/entity/suv_lime",
        "cyan": "textures/entity/suv_cyan",
        "light_blue": "textures/entity/suv_light_blue",
        "blue": "textures/entity/suv_blue",
        "purple": "textures/entity/suv_purple",
        "magenta": "textures/entity/suv_magenta",
        "pink": "textures/entity/suv_pink"
      },
      "geometry": { "default": "geometry.mycar.suv" },
      "animations": {
        "dive": "animation.mycar.suv.dive",
        "submerged": "animation.mycar.suv.submerged",
        "surface": "animation.mycar.suv.surface",
        "wheels": "animation.mycar.suv.wheels",
        "wheels_deploy": "animation.mycar.suv.wheels_deploy",
        "wheels_folded": "animation.mycar.suv.wheels_folded",
        "wheels_retract": "animation.mycar.suv.wheels_retract",
        "hover_glow": "animation.mycar.suv.hover_glow",
        "bank": "animation.mycar.suv.bank",
        "exhaust": "animation.mycar.suv.exhaust",
        "engine_sound_0": "animation.mycar.suv.engine_sound_0",
        "engine_sound_1": "animation.mycar.suv.engine_sound_1",
        "engine_sound_2": "animation.mycar.suv.engine_sound_2",
        "engine_sound_3": "animation.mycar.suv.engine_sound_3",
        "engine_sound_4": "animation.mycar.suv.engine_sound_4",
        "engine_sound_5": "animation.mycar.suv.engine_sound_5",
        "hover_sound_0": "animation.mycar.suv.hover_sound_0",
        "hover_sound_1": "animation.mycar.suv.hover_sound_1",
        "hover_sound_2": "animation.mycar.suv.hover_sound_2",
        "hover_sound_3": "animation.mycar.suv.hover_sound_3",
        "hover_sound_4": "animation.mycar.suv.hover_sound_4",
        "form": "controller.animation.mycar.suv.form"
      },
      "sound_effects": {
        "engine_0": "mycar.engine_0",
        "engine_1": "mycar.engine_1",
        "engine_2": "mycar.engine_2",
        "engine_3": "mycar.engine_3",
        "engine_4": "mycar.engine_4",
        "engine_5": "mycar.engine_5",
        "hover_0": "mycar.hover_0",
        "hover_1": "mycar.hover_1",
        "hover_2": "mycar.hover_2",
        "hover_3": "mycar.hover_3",
        "hover_4": "mycar.hover_4",
        "hover_start": "mycar.hover_start"
      },
      "particle_effects": {
        "exhaust": "minecraft:basic_smoke_particle",
        "hover_glow": "mycar:hover_glow"
      },
      "scripts": {
        "animate": [
          "form",
          "bank",
          { "exhaust": "query.has_rider" },
          {
            "engine_sound_0": "query.has_rider && query.property('mycar:form') == 'car' && query.ground_speed < 1"
          },
          {
            "engine_sound_1": "query.has_rider && query.property('mycar:form') == 'car' && query.ground_speed >= 1 && query.ground_speed < 4.5"
          },
          {
            "engine_sound_2": "query.has_rider && query.property('mycar:form') == 'car' && query.ground_speed >= 4.5 && query.ground_speed < 8"
          },
          {
            "engine_sound_3": "query.has_rider && query.property('mycar:form') == 'car' && query.ground_speed >= 8 && query.ground_speed < 11.5"
          },
          {
            "engine_sound_4": "query.has_rider && query.property('mycar:form') == 'car' && query.ground_speed >= 11.5 && query.ground_speed < 15"
          },
          {
            "engine_sound_5": "query.has_rider && query.property('mycar:form') == 'car' && query.ground_speed >= 15"
          }
        ]
      },
      "render_controllers": ["controller.render.mycar.suv"]
    }
  }
}
