{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.mycar.suv": {
      "arrays": {
        "textures": {
          "Array.paints": ["Texture.default", "Texture.green", "Texture.red"]
        },
        "materials": {
          "Array.lamps": ["Material.lamp", "Material.lamp_lit"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" },
        {
          "headlights": "Array.lamps[query.property('mycar:headlights') ? 1 : 0]"
        }
      ],
      "textures": ["Array.paints[query.variant]"],
      "part_visibility": [
        { "*": true },
        { "glow_*": "!query.property('mycar:gear_down')" },
        { "rear_glass": "query.property('mycar:flight') != 'ground'" }
      ]
    }
  }
}
