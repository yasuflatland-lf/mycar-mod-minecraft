        "hover_1": "yasuflatland.hover_1",
        "hover_2": "yasuflatland.hover_2",
        "hover_3": "yasuflatland.hover_3",
        "hover_4": "yasuflatland.hover_4",
        "hover_start": "yasuflatland.hover_start",
        "sonar": "yasuflatland.sonar"
      },
      "particle_effects": {
        "exhaust": "minecraft:basic_smoke_particle",
        "hover_glow": "yasuflatland:hover_glow"
      },
      "scripts": {
        "animate": [
          "form",
          "bank",
          { "exhaust": "query.has_rider" },
          {
            "engine_sound_0": "query.has_rider && query.property('yasuflatland:form') == 'car' && query.ground_speed < 1"
          },
          {
            "engine_sound_1": "query.has_rider && query.property('yasuflatland:form') == 'car' && query.ground_speed >= 1 && query.ground_speed < 4.5"
          },
          {
            "engine_sound_2": "query.has_rider && query.property('yasuflatland:form') == 'car' && query.ground_speed >= 4.5 && query.ground_speed < 8"
          },
          {
            "engine_sound_3": "query.has_rider && query.property('yasuflatland:form') == 'car' && query.ground_speed >= 8 && query.ground_speed < 11.5"
          },
          {
            "engine_sound_4": "query.has_rider && query.property('yasuflatland:form') == 'car' && query.ground_speed >= 11.5 && query.ground_speed < 15"
          },
          {
            "engine_sound_5": "query.has_rider && query.property('yasuflatland:form') == 'car' && query.ground_speed >= 15"
          }
        ]
      },
      "render_controllers": ["controller.render.yasuflatland.suv"]
    }
