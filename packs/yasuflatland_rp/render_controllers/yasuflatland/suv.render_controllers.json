{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.yasuflatland.suv": {
      "arrays": {
        "textures": {
          "Array.paints": [
            "Texture.default",
            "Texture.green",
            "Texture.red",
            "Texture.white",
            "Texture.light_gray",
            "Texture.gray",
            "Texture.black",
            "Texture.orange",
            "Texture.yellow",
            "Texture.lime",
            "Texture.cyan",
            "Texture.light_blue",
            "Texture.blue",
            "Texture.purple",
            "Texture.magenta",
            "Texture.pink"
          ]
        },
        "materials": {
          "Array.lamps": ["Material.lamp", "Material.lamp_lit"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" },
        {
          "headlights": "Array.lamps[query.property('yasuflatland:headlights') ? 1 : 0]"
        }
      ],
      "textures": ["Array.paints[query.variant]"],
      "part_visibility": [
        { "*": true },
        { "glow_*": "!query.property('yasuflatland:gear_down')" },
        { "rear_glass": "query.property('yasuflatland:form') != 'car'" },
        {
          "windows_sealed": "query.property('yasuflatland:form') == 'submarine'"
        }
      ]
    }
  }
}
